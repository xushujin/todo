# Local release signing channel.
#
# 1. Copy this file to `keystore.properties` (it is git-ignored).
# 2. Generate a keystore once and keep it outside the repository:
#
#    keytool -genkeypair -v \
#      -keystore ~/keys/todo-release.jks \
#      -alias todo \
#      -keyalg RSA -keysize 4096 -validity 10000
#
# 3. Fill in the values below. `storeFile` is resolved against the repository root,
#    so an absolute path is recommended.
#
# CI uses the other channel (environment variables), see README "Signing".

storeFile=/absolute/path/to/todo-release.jks
storePassword=change-me
keyAlias=todo
keyPassword=change-me
