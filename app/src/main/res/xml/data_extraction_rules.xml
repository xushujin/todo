<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups are disabled on purpose (allowBackup="false"): the database holds the
  user's tasks and SharedPreferences holds the encrypted git token / SMTP password.
  These rules state the same thing explicitly for Android 12+ device-to-device
  transfer, which ignores allowBackup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
