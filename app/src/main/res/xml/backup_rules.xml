<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups are disabled (allowBackup="false"). This file exists so the manifest is
  explicit for Android 11 and lower, while data_extraction_rules.xml covers 12+.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
