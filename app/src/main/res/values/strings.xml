    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_app">Application</string>
    <string name="about_version">Version</string>
    <string name="about_package">Package</string>
    <string name="about_stack">Tech stack</string>
    <string name="about_stack_value">Kotlin · Jetpack Compose · hand-written SQLite storage · hand-written JSON + git REST sync · hand-written SMTP client</string>
    <string name="about_support">Supported range</string>
    <string name="about_support_value">Android 11 (API 30) through Android 16 (API 36). No third-party UI or DI libraries.</string>
    <string name="about_permissions">Permissions</string>
    <string name="about_permissions_value">Internet + network state (git sync, email reminders) · notifications · exact alarms · boot completed (reschedule reminders) · biometric (app lock) · vibrate/wake lock (alarm delivery)</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_value">All task data stays in the local database. Nothing is uploaded unless you configure a git repository. Tokens and SMTP passwords are encrypted with an Android Keystore key.</string>
    <string name="about_licenses">Libraries</string>
    <string name="about_licenses_value">AndroidX Core, Activity Compose, Lifecycle, Compose UI / Foundation / Material 3, Kotlin coroutines. No UI kit, no DI framework, no JGit, no JavaMail.</string>
    <string name="about_license">License</string>
    <string name="about_license_value">Apache License 2.0. Free to use, modify and redistribute, including commercially, provided the copyright and license notices are kept and a copy of the license is included.</string>

